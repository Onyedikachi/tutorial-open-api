# mTLS gateway for the Open Banking Nigeria resource/payment API.
#
# Models the real-world split used by Open Banking specs (UK OBIE, CBN
# Nigeria Operational Guidelines): a plain OAuth2-only host for the
# authorization/consent journey the end-user's browser talks to, and a
# separate "matls." host that TPP *backends* call for AISP/PISP resource
# calls, which requires a certificate-bound access token (mTLS + OAuth2
# together). This container terminates that second, mTLS-protected path.
#
# It does NOT re-implement application auth. It only:
#   1. Requires and verifies the caller's client certificate against ca.crt.
#   2. Forwards the verification result and certificate identity to the
#      Node app via headers. The app (MTLSMiddleware) is the one that
#      decides whether the identified TPP is registered and what access
#      rules it has been granted.
#
# The app also stays reachable directly on :3000 for the browser-based demo
# frontend, which intentionally bypasses mTLS (see README) exactly as a real
# TPP's own end-user-facing frontend would never itself present a transport
# cert. That means a caller could reach :3000 directly and forge the
# X-SSL-Client-* headers this proxy sets. To close that hole without fully
# network-isolating the app (see nginx/README.md), this proxy also forwards
# a shared secret that only it knows; MTLSMiddleware rejects any request
# missing it. Set MTLS_GATEWAY_SECRET to the same value here (via .env, read
# by docker compose) and in the app's own environment before starting either.
#
# This file is a template: docker's nginx image envsubst's ${Var} references
# that match actual environment variable names on container start, writing
# the result to /etc/nginx/conf.d/. nginx's own request-time variables
# (unprefixed by env vars, e.g. $host, $ssl_client_verify) are untouched
# because they aren't environment variables of the container process.

server {
    listen 8443 ssl;
    server_name matls.openbanking.local;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Require and verify a client certificate signed by our dev CA.
    ssl_client_certificate /etc/nginx/certs/ca.crt;
    ssl_verify_client      on;
    ssl_verify_depth       2;

    location / {
        proxy_pass http://backend_upstream;

        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        # Client certificate identity, forwarded for MTLSMiddleware.
        proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
        proxy_set_header X-SSL-Client-S-DN   $ssl_client_s_dn;
        proxy_set_header X-SSL-Client-Serial $ssl_client_serial;
        proxy_set_header X-SSL-Client-Cert   $ssl_client_escaped_cert;

        # Proves this request actually came through this proxy (see note
        # above) rather than being sent straight to :3000 with forged
        # X-SSL-Client-* headers.
        proxy_set_header X-Gateway-Secret    "${MTLS_GATEWAY_SECRET}";
    }
}

upstream backend_upstream {
    server host.docker.internal:3000;
}
