# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=openbanking

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# OAuth2 / OIDC
ISSUER_URL=http://localhost:3000
API_URL=http://localhost:3000
JWT_EXPIRY=1h

# RS256 keypair for signing access tokens (and JWE for PIFT/PAST, see
# jwt-encryption.service.ts). Generate with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Paste each PEM in with real newlines (e.g. export JWT_PRIVATE_KEY="$(cat jwt_private.pem)").
# The public half is served at GET /auth/jwks so
# tutorial-open-banking-api-gateway can verify tokens independently.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ENCRYPTION_KEY=

# Shared secret proving a request actually came from
# tutorial-open-banking-api-gateway rather than being sent directly to
# :3000's payment/account routes. Generate with: openssl rand -hex 32
# Must match INTERNAL_GATEWAY_SECRET in the gateway repo's .env.
INTERNAL_GATEWAY_SECRET=
